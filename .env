# ── Required ──────────────────────────────────────────────────────────────────
# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ── GitHub Models AI (required for all AI features) ───────────────────────────
# Create a token at https://github.com/settings/tokens
# Required scope: models:read  (under "GitHub Models" in token settings)
GITHUB_TOKEN=your_github_token_here

# Model to use via GitHub Models. Default: openai/gpt-4o
# Other options: openai/gpt-4o-mini, meta/llama-3.1-405b-instruct, etc.
# Full list: https://github.com/marketplace/models
GITHUB_MODEL=openai/gpt-4o

# ── Optional ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
